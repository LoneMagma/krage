{
  "name": "krage-arena",
  "version": "1.10.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib/game lib/account components/game tests server",
    "format": "oxfmt",
    "test": "tsc -p tsconfig.test.json && node .test-build/tests/core.test.js && node .test-build/tests/presentation.test.js",
    "build:server": "tsc -p tsconfig.server.json",
    "server": "npm run build:server && node server/index.mjs",
    "test:server": "npm run build:server && node --test tests/server.test.mjs",
    "deploy:web": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "build:render": "KRAGE_NODE=1 vinext build",
    "start:render": "vinext start",
    "test:accounts": "npm run build:server && node --test tests/accounts.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/three": "^0.180.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.180.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "type": "module"
}
