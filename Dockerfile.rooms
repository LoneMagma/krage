FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig*.json ./
COPY lib/game ./lib/game
RUN npm run build:server
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production KRAGE_HOST=0.0.0.0 KRAGE_PORT=3002
COPY --from=build /app/node_modules/ws ./node_modules/ws
COPY --from=build /app/.server-build ./.server-build
COPY package.json ./package.json
COPY server ./server
RUN mkdir -p /app/server/data/account-outbox /tmp/krage-account-outbox \
 && chown -R node:node /app/server/data /tmp/krage-account-outbox
ENV KRAGE_ACCOUNT_OUTBOX=/tmp/krage-account-outbox
USER node
EXPOSE 3002
CMD ["node", "server/index.mjs"]
