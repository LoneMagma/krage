FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig*.json ./
COPY lib/game ./lib/game
RUN ./node_modules/.bin/tsc -p tsconfig.server.json
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production KRAGE_HOST=0.0.0.0 KRAGE_PORT=3002
COPY --from=build /app/node_modules/ws ./node_modules/ws
COPY --from=build /app/.server-build ./.server-build
COPY --from=build /app/package.json ./package.json
COPY server ./server
RUN mkdir -p /app/server/data/account-outbox \
 && chown -R node:node /app/server/data
ENV KRAGE_ACCOUNT_OUTBOX=/app/server/data/account-outbox
USER node
EXPOSE 3002
CMD ["node", "server/index.mjs"]
